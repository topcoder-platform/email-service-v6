# Valid Kafka mTLS is checked locally before startup without contacting brokers.
# Invalid material fails with "Invalid Kafka mTLS configuration"; unreachable
# brokers do not block HTTP startup and are handled by the reconnect lifecycle.
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/email
POSTGRES_SCHEMA=email

SENDGRID_API_KEY=SG.example.key
EMAIL_FROM=noreply@example.com
# JSON object mapping Kafka topic names to non-empty SendGrid template IDs.
EMAIL_TEMPLATE_MAP={"notifications.email":"d-example-template-id"}
EMAIL_TEMPLATE_OVERRIDE_KEY=sendgrid_template_id
# Defaults to every two minutes at second zero using six-field cron syntax.
EMAIL_RETRY_CRON=0 */2 * * * *
# Defaults to a 24-hour eligibility window.
EMAIL_RETRY_MAX_AGE_MS=86400000

# Set DISABLE_KAFKA=true to run the API and retry scheduler without a consumer.
KAFKA_URL=localhost:9092
KAFKA_CLIENT_ID=email-service-v6
KAFKA_GROUP_ID=email-service-v6
KAFKA_SSL_ENABLED=false
# Use escaped newlines (\n) in mTLS cert, key, and optional CA bundle values.
# Client cert and key are required only when SSL is enabled and Kafka is active.
# Every supplied CA certificate block is validated; an empty bundle is invalid.
# A non-empty passphrase preserves exact whitespace; an empty value is omitted.
# DISABLE_KAFKA=true or KAFKA_SSL_ENABLED=false bypasses cryptographic validation.
# Use secret injection rather than committed values; keep placeholders here empty.
KAFKA_CLIENT_CERT=
KAFKA_CLIENT_CERT_KEY=
KAFKA_CA_CERT=
KAFKA_CLIENT_CERT_PASSPHRASE=
KAFKA_CONNECTION_TIMEOUT=10000
KAFKA_REQUEST_TIMEOUT=30000
# Defaults align with @platformatic/kafka 2.8.0 when omitted.
KAFKA_BROKER_TIMEOUT=5000
KAFKA_SESSION_TIMEOUT=60000
KAFKA_HEARTBEAT_INTERVAL=3000
KAFKA_RETRY_ATTEMPTS=5
KAFKA_INITIAL_RETRY_TIME=300
KAFKA_MAX_RETRY_TIME=30000
KAFKA_MAXBYTES=1048576
KAFKA_MAX_WAIT_TIME=5000
DISABLE_KAFKA=false
